[user]
	name = Alex Pearson
	email = alex@alexpear.com
[core]
	editor = nvim
[init]
	defaultBranch = main
[diff]
        tool = diffsitter
[difftool]
        prompt = false
[difftool "diffsitter"]
        cmd = diffsitter "$LOCAL" "$REMOTE"
[credential "https://github.com"]
	helper = 
	helper = !/opt/homebrew/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !/opt/homebrew/bin/gh auth git-credential
[credential "https://ampcode.com"]
	helper = !amp git-credential-helper
